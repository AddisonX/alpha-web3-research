      "trust_env": true,
      "requests_trust_env": true,
      "aiohttp_trust_env": true,
      "timeout": 15000,
      "options": {
        "fetchMarkets": {
          "types": [
            "linear"
          ]
        },
        "fetchCurrencies": false
      }
    },
