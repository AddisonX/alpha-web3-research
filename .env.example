ALPHA_EXCHANGE_ID=binanceusdm
ALPHA_MARKET_TYPE=swap
ALPHA_QUOTE_ASSET=USDT
ALPHA_SANDBOX=false
ALPHA_ENABLE_RATE_LIMIT=true
ALPHA_CCXT_TIMEOUT_MS=30000
ALPHA_DATA_PATH=data
ALPHA_REPORTS_PATH=reports

# Only needed for private endpoints or Binance Futures Testnet trading.
ALPHA_BINANCE_API_KEY=
ALPHA_BINANCE_SECRET=

# Historical data adapter: auto or binance_official_ccxt
ALPHA_DATA_PROVIDER=auto

# Registered decision policy. The existing Tokyo policy remains the default.
ALPHA_LIVE_STRATEGY=tokyo-lightgbm-long-only-v1

# Opt-in to the machine's existing network/proxy environment. Default stays false.
ALPHA_CCXT_TRUST_ENV=false
