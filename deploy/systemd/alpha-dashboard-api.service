[Unit]
Description=Alpha Web3 live dashboard read-only API
After=network-online.target alpha-freqtrade-dryrun.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/alpha-web3-research
Environment=PATH=/home/ubuntu/alpha-web3-research/.venv/bin:/usr/bin
Environment=ALPHA_PROJECT_ROOT=/home/ubuntu/alpha-web3-research
Environment=ALPHA_DASHBOARD_MARKET_DATA_SOURCE=binance_futures
ExecStart=/home/ubuntu/alpha-web3-research/.venv/bin/uvicorn src.live.dashboard:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
